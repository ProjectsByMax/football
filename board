<meta property="og:title" content="The Dumb Idiot Tracker">
<meta property="og:description" content="Max vs Michael — 2026 NFL season pick tracker. One of us is the dumb idiot.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>%F0%9F%8F%88</text></svg>">
